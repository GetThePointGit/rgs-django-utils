{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-secret-print.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "rgs": {
      "source": {
        "source": "github",
        "repo": "GetThePointGit/rgs-dev-config"
      }
    }
  },
  "enabledPlugins": {
    "rgs-secrets@rgs": true,
    "rgs-werkwijze@rgs": true
  }
}
